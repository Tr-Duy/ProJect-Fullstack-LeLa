# Environment Configuration for Frontend (LeLa_FE)

# Backend API Base URL (including /api/v1 prefix)
# Example Production: https://your-backend-service.onrender.com/api/v1
VITE_API_URL=https://<your-backend-domain>.onrender.com/api/v1

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com

# Pixabay Image Search Key
VITE_PIXABAY_KEY=<your-pixabay-api-key>
